# Mole-BERT is fetched by download/download_molebert.sh, not committed.
# Only rationale/molebert/patches/ is ours and belongs in the repository.
/rationale/molebert/*
!/rationale/molebert/patches/
/rationale/molebert/patches/*.rej
/rationale/molebert/patches/*.orig

# Fetched weights
/checkpoints/

# Model checkpoints — released on Hugging Face, never committed
*.pt
*.ckpt

# Built data — released on Hugging Face, not committed.
# The builders (data_prep/**/*.py) and the instruction templates stay.
/data_prep/stage1/train.json
/data_prep/stage2/train/
/data_prep/stage2/valid/
/data_prep/stage2/test/
/used_data_rationale/

# Generated by the pipeline
/rationale/attribution/output/
/rationale/attribution/result/
/rationale/format/generated/
/experiments/
/results/

# Python / tooling
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store
